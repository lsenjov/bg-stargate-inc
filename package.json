{
  "name": "stargate-inc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev": "npm run dev --workspace=@stargate-inc/client",
    "dev:server": "npm run dev --workspace=@stargate-inc/server",
    "lint": "eslint packages",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.15.34",
    "eslint": "^9.30.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
