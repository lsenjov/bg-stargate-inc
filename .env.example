# Server runtime. PORT is normally supplied by the deployment platform.
PORT=3001

# Optional cross-origin browser origin. Production uses the server's own origin.
CLIENT_ORIGIN=http://localhost:5173

# Optional override. The default is packages/client/dist relative to the server build.
CLIENT_DIST_PATH=packages/client/dist

# Vite development proxy target. Set this in packages/client/.env only when the
# development server is not at the default http://localhost:3001.
VITE_DEV_SERVER_URL=http://localhost:3001
